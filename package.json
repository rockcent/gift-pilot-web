{
  "name": "@rockcent/gift-pilot-web",
  "version": "0.6.0-web-mvp",
  "private": true,
  "description": "礼有方（GiftPilot）网页端：C 端用户界面 + 平台管理后台 · MVP v0.6",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "smoke:web": "node ./scripts/smoke-web.mjs",
    "check:platform-deps": "node ./scripts/check-platform-deps-local.mjs",
    "check:no-sensitive": "node ./scripts/check-no-sensitive.mjs",
    "deploy:preflight": "bash scripts/deploy-preflight.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "deploy:dry-run": "RSYNC_DRY_RUN=1 bash scripts/deploy-production.sh"
  },
  "dependencies": {
    "@rockcent/platform": "git+https://github.com/rockcent/rockcent-platform.git#platform-v1.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.71.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
