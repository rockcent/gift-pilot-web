# 礼有方网页端环境变量示例
APP_ENV=development

# 后端 API base URL（MVP 留空走 mock）
API_BASE=

# AI 提供商（MVP mock）
AI_PROVIDER=mock
AI_MODEL=giftpilot-v0
AI_GATEWAY_TRACE=1

# 平台 tag
ROCKCENT_PLATFORM_TAG=platform-v1.15.2

# 管理后台登录密码（MVP mock 阶段单一密码；阶段二起接 OAuth）
VITE_ADMIN_PASSWORD=admin123

# 微信 AppID（占位）
WX_APPID_PLACEHOLDER=
